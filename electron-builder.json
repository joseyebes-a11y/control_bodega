{
  "appId": "com.microcellerstudio.desktop",
  "productName": "MicroCellerStudio",
  "directories": { "output": "dist-desktop" },
  "files": [
    "desktop/**", "public/**", "services/**", "rules/**",
    "schema.sql", "server.js", "package.json"
  ],
  "asar": true,
  "asarUnpack": ["**/node_modules/sqlite3/**"],
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "icon": "public/icons/app.ico",
    "signAndEditExecutable": true,
    "signExecutable": false,
    "artifactName": "MicroCellerStudio-${version}-Windows-${arch}-Setup.${ext}"
  },
  "nsis": {
    "installerIcon": "public/icons/app.ico",
    "uninstallerIcon": "public/icons/app.ico",
    "include": "desktop/installer.nsh",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "MicroCellerStudio",
    "deleteAppDataOnUninstall": false,
    "installerLanguages": ["es_ES"],
    "displayLanguageSelector": false
  }
}
